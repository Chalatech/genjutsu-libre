# Obtain your own keys. Never share a populated .env. Anything left blank uses the upstream default.

# --- Generation provider -------------------------------------------------------------------------
# enhancor (default) | kie | openrouter. See docs/PROVIDERS.md.
GEN_BACKEND=enhancor
# Spending cap in USD per request, for any provider. Above it nothing is uploaded or sent.
GEN_MAX_USD=3

# Enhancor
ENHANCOR_API_KEY=
ENHANCOR_BASE_URL=https://apireq.enhancor.ai/api/seedance2.5/v1
# Required by Enhancor only. Leave blank to use the automatic cloudflared callback tunnel.
ENHANCOR_WEBHOOK_URL=
# tmpfiles (temporary) or catbox (public persistent hosting). Only Enhancor needs public media URLs.
MEDIA_HOST=tmpfiles
# Comma-separated fallback hosts. Catbox is public and persistent; leave empty to disable.
MEDIA_HOST_FALLBACKS=catbox
CATBOX_USERHASH=

# Kie.ai (no webhook, no public media host: files go through Kie's own file API, kept 24 h)
KIE_API_KEY=
KIE_MODEL=bytedance/seedance-2-5
# Credits per billable second; billable = reference seconds + output seconds, 1 credit = $0.005.
KIE_UNIT_CREDITS=17
# Resolution of the final pass (720p or 1080p).
KIE_HD_RESOLUTION=1080p

# OpenRouter (cannot run this workflow yet: no model accepts a reference video; see docs/PROVIDERS.md)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- Preparation backend -------------------------------------------------------------------------
# replicate (default: Replicate/Hugging Face hosted models) | gpu (your own GPU host, docs/LOCAL-GPU.md).
# With gpu no Replicate token is needed.
PREP_BACKEND=replicate
REPLICATE_API_TOKEN=
# Only needed to download SAM 3 weights or use the Hugging Face depth provider (your own account).
HF_TOKEN=
# Subject mask model on the GPU host: sam3 (default) | sam2 (not implemented yet).
SEGMENT_MODEL=sam3
# Optional, off by default: stretch the depth range inside each selected subject to the full colormap so
# far subjects are not flat single-colour silhouettes. 1 = on.
DEPTH_SUBJECT_STRETCH=

# --- GPU host (PREP_BACKEND=gpu) -----------------------------------------------------------------
# ssh alias from ~/.ssh/config, the only folder written on the host, and its venv python.
# Preparation runs on this machine; only model inference goes to an API on the host, reached through an
# ssh tunnel (the API listens on the host's loopback only). Deploy workers/ once with:
#   rsync -az --exclude __pycache__ gpu_workers/ "$GPU_HOST:$GPU_DIR/workers/"
GPU_HOST=
GPU_DIR=
GPU_PYTHON=
# Folder on the GPU host with SAM 3 weights (transformers format); HF_TOKEN is only needed to download them.
SAM3_WEIGHTS=

# Inference API on the host. A server that is already running keeps the limits it was started with.
GPU_API_PORT=18770
# Optional bearer token the server requires (leave empty for none).
GPU_API_TOKEN=
# Minutes idle before models are unloaded / the server exits on its own, and minutes before job files expire.
GPU_API_UNLOAD_IDLE_MIN=10
GPU_API_EXIT_IDLE_MIN=30
GPU_API_TTL_MIN=60

# Memory guard on the host: free GB needed before each model runs, seconds between re-checks, and minutes
# to wait before giving up. Passed to the server when this app starts it.
GPU_MIN_FREE_GB=20
GPU_MEM_POLL_S=120
GPU_MEM_WAIT_MIN=30
