# Obtain your own keys. Never share a populated .env.
ENHANCOR_API_KEY=
REPLICATE_API_TOKEN=
HF_TOKEN=
ENHANCOR_BASE_URL=https://apireq.enhancor.ai/api/seedance2.5/v1
# Required by Enhancor. Leave blank to use the automatic cloudflared callback tunnel.
ENHANCOR_WEBHOOK_URL=
# tmpfiles (temporary) or catbox (public persistent hosting)
MEDIA_HOST=tmpfiles
# Comma-separated fallback hosts. Catbox is public and persistent; leave empty to disable.
MEDIA_HOST_FALLBACKS=catbox
CATBOX_USERHASH=

# Preparation backend: replicate (default) or gpu (workers on your own GPU host, no Replicate token needed).
PREP_BACKEND=replicate
# GPU backend: ssh alias from ~/.ssh/config, the only folder written on the host, and its venv python.
# Preparation runs on this machine; only the model inference goes to an API on the host, reached through
# an ssh tunnel (the API listens on the host's loopback only). Deploy workers/ once with:
#   rsync -az --exclude __pycache__ gpu_workers/ "$GPU_HOST:$GPU_DIR/workers/"
GPU_HOST=
GPU_DIR=
GPU_PYTHON=
GPU_API_PORT=18770
# Optional bearer token the server requires (leave empty for none).
GPU_API_TOKEN=
# Server limits, applied when the client starts it: minutes idle before models are unloaded / the server
# exits on its own, and minutes before job files expire on the host.
GPU_API_UNLOAD_IDLE_MIN=10
GPU_API_EXIT_IDLE_MIN=30
GPU_API_TTL_MIN=60
# Free memory the host must have before each model runs, seconds between re-checks, and minutes to wait.
GPU_MIN_FREE_GB=20
GPU_MEM_POLL_S=120
GPU_MEM_WAIT_MIN=30
SEGMENT_MODEL=sam3
# Folder on the GPU host with SAM 3 weights (transformers format); HF_TOKEN is only needed to download them.
SAM3_WEIGHTS=
